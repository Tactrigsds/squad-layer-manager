{
	"useTabs": true,
	"tabWidth": 3,
	"printWidth": 140,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"objectWrap": "preserve",
	"sortPackageJson": false,
	"ignorePatterns": [
		"data/**",
		"prod/**",
		"assets/**",
		"**/*-lock.json",
		"**/*-lock.yaml",
		"**/routeTree.gen.ts",
		".tanstack/**",
		"drizzle/**/*.json",
		"drizzle-sqlite/**/*.json",
		".claude/worktrees/**"
	],
	"sortImports": {
		"internalPattern": ["@/", "$root/"],
		"groups": [
			["side_effect_style", "side_effect"],
			["value-builtin", "value-external", "type-import"],
			["value-internal", "type-internal"],
			["value-parent", "value-sibling", "value-index", "type-parent", "type-sibling", "type-index"],
			"unknown"
		],
		"newlinesBetween": true,
		"order": "asc",
		"ignoreCase": true,
		"sortSideEffects": true
	}
}
