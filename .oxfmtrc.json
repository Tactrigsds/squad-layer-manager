{
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 140,
	"semi": false,
	"singleQuote": true,
	"jsxSingleQuote": false,
	"trailingComma": "all",
	"objectWrap": "preserve",
	"sortPackageJson": false,
	"ignorePatterns": [
		"data/**",
		"prod/**",
		"assets/**",
		"**/*-lock.json",
		"**/*-lock.yaml",
		"**/routeTree.gen.ts",
		".tanstack/**",
		"drizzle/**/*.json",
		"drizzle-sqlite/**/*.json",
		".claude/worktrees/**"
	]
}
