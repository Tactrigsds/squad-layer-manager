{
	"name": "squad-layer-manager",
	"build": {
		"dockerfile": "Dockerfile",
		// the image takes only the flake from the repo (the workspace is bind-mounted, and the install happens in
		// post-create), so the context is nix/ rather than the repo root -- data/ alone is several GB to hand to the
		// daemon for nothing
		"context": "../nix"
	},
	"remoteUser": "vscode",

	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// The directory holding this checkout is mounted, not just the checkout, and at the same path as on the host.
	// `pnpm worktree new` creates worktrees beside the main checkout, and a worktree finds the shared git dir through
	// an absolute host path, so one container serves every worktree only when both are true.
	"workspaceMount": "source=${localWorkspaceFolder}/..,target=${localWorkspaceFolder}/..,type=bind",
	"workspaceFolder": "${localWorkspaceFolder}",

	"mounts": [
		// node_modules is a volume rather than part of the bind mount on purpose: the native deps (better-sqlite3,
		// cpu-features, bufferutil) are compiled against the container's glibc, and a tree built on the host will
		// not load in here. The container keeps its own install; the host keeps its own. A worktree's node_modules
		// is not covered by this, so it belongs to whichever side provisioned the worktree.
		"source=slm-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
		// shared by every container: a rebuild installs from the store instead of re-downloading the world, and
		// downloads each browser build once
		"source=slm-pnpm-store,target=/pnpm/store,type=volume",
		"source=slm-ms-playwright,target=/ms-playwright,type=volume"
	],

	// NOTE: these win over .env. The app reads process.env first and dotenv does not overwrite what is already set
	// (see src/server/env.ts ensureEnvSetup), so anything set here cannot be overridden from .env -- only by the shell
	// you launch the process in.
	"containerEnv": {
		"SLM_WORKTREE_ROOT": "${localWorkspaceFolder}/.."
	},
	"remoteEnv": {
		// the repo's tools (oxfmt, oxlint, vitest, playwright, drizzle-kit) are devDependencies, and nothing puts them
		// on PATH outside of `pnpm run`. `${containerEnv:...}` only resolves here, not in containerEnv.
		"PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
	},
	// Host networking, so every `pnpm dev` slot's ports (3100 and up, see src/dev/slots.ts) are reachable from the
	// host's browser, along with vite, which listens on localhost only. The observability stack on the host is
	// reachable at its usual localhost ports in turn. Linux only.
	"runArgs": ["--network=host"],

	"postCreateCommand": "bash .devcontainer/post-create.sh",

	"customizations": {
		// only the languages the repo actually contains that Zed does not handle out of the box. Everything else it
		// needs (typescript, tailwind, the oxfmt formatter and the oxc lsp) is either built in or configured in
		// .zed/settings.json, which rides along in the bind mount.
		// NOTE: these install into your local Zed too, not just the container's session.
		"zed": {
			"extensions": ["dockerfile", "sql", "html", "nix"]
		},
		"vscode": {
			"extensions": ["oxc.oxc-vscode", "bradlc.vscode-tailwindcss", "ms-playwright.playwright", "vitest.explorer"],
			"settings": {
				// the repo is on a typescript prerelease; VS Code has to be pointed at it explicitly
				"typescript.tsdk": "node_modules/typescript/lib",
				"editor.defaultFormatter": "oxc.oxc-vscode",
				"editor.formatOnSave": true,
				"terminal.integrated.defaultProfile.linux": "bash"
			}
		}
	}
}
