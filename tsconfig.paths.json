{
	"compilerOptions": {
		"paths": {
			"@/*": ["./src/*"],
			"$root/*": ["./*"],
			"slm/plugin": ["./src/plugin-api/plugin/index.ts"],
			"slm/*": ["./src/plugin-api/*"],
			"slm-internal/*": ["./src/*"]
		},
		"resolveJsonModule": true,
		/* Linting */
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"noFallthroughCasesInSwitch": true
	}
}
